{
  "name": "azure-devops-service-starter",
  "version": "1.0.0",
  "description": "Production-minded Azure Container Apps service starter with GitHub Actions, GHCR, Docker, Bicep, testing, and operational documentation.",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "init:template": "node scripts/init-template.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "keywords": [
    "azure",
    "devops",
    "typescript",
    "express",
    "github-actions",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3"
  }
}
